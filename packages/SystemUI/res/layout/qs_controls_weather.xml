<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/qs_controls_weather">

    <LinearLayout
        android:id="@+id/qs_controls_weather_layout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/qs_controls_slider_margin_top"
        android:layout_marginBottom="@dimen/qs_controls_slider_margin_bottom"
        android:layout_marginEnd="@dimen/qs_controls_tile_margin_end"
        android:background="@drawable/qs_controls_background"
        android:backgroundTint="@color/qs_controls_surface_color"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">
        
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/weather_content_container"
            android:layout_width="match_parent"
            android:layout_height="@dimen/qs_controls_tile_height"
            android:paddingTop="16dp"
            android:paddingHorizontal="16dp">
        
        <LinearLayout
            android:id="@+id/weather_main_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                
                <com.android.systemui.weather.WeatherTextView
                    android:id="@+id/weather_text_full"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="@*android:color/white"
                    android:textStyle="bold"
                    android:visibility="gone" />
                    
            </LinearLayout>
            
            <com.android.systemui.weather.WeatherImageView
                android:id="@+id/weather_image"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="16dp"
                android:visibility="gone" />
                
        </LinearLayout>
        
        <LinearLayout
            android:id="@+id/battery_status_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/weather_main_container">
            
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="start">
                
                <TextView
                    android:id="@+id/battery_percentage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="18sp"
                    android:textColor="@*android:color/white"
                    android:text="64%" />
                    
                <TextView
                    android:id="@+id/battery_temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textColor="@*android:color/white"
                    android:alpha="0.7"
                    android:text="32°C" />
                    
            </LinearLayout>
            
            <TextView
                android:id="@+id/battery_remaining"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textColor="@*android:color/white"
                android:alpha="0.8"
                android:gravity="end"
                android:text="Until 4:15 PM" />
                
        </LinearLayout>
        
        <com.android.systemui.qs.QsControlsPageIndicator
            android:id="@+id/weather_page_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/battery_status_container"/>
            
        </androidx.constraintlayout.widget.ConstraintLayout>
            
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
